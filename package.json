{
  "name": "my-workbuddy-guide",
  "version": "0.1.0",
  "private": true,
  "description": "WorkBuddy 大白话指南 - 一个普通用户的 WorkBuddy 学习笔记",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vuepress dev docs --host 0.0.0.0",
